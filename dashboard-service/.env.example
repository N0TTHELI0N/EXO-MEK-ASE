# ────────────────────────────────────────────────────────────
#  DASHBOARD SERVICE — environment contract
# ────────────────────────────────────────────────────────────
#  Copy to .env for local dev, or paste into the Render service's
#  "Environment variables" tab.
#
#  ⚠️  THE SHARED VALUES (marked [SHARED]) MUST BE BYTE-IDENTICAL TO THE
#      BOT SERVICE. They are what lets two independent services cooperate:
#        - DATABASE_URL   -> one shared PostgreSQL (the source of truth)
#        - ENCRYPTION_KEY -> same Fernet key, so the dashboard can decrypt
#                            the Nitrado/API secrets the bot encrypted
#        - NITRADO_*      -> same Nitrado account, same game servers
#        - Discord OAuth  -> same app, so logins work on both services
# ────────────────────────────────────────────────────────────

# [SHARED] Central PostgreSQL — the only channel between the two services.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# [SHARED] Fernet key for stored secrets. Copy the EXACT value from the bot.
#   generate (once, then never rotate): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# [SHARED] Key used to SIGN license keys. The dashboard validates licenses the
#   bot issued, so this must match the bot's value too (or leave it unset on
#   both sides, in which case ENCRYPTION_KEY is used as the signing key).
LICENSE_SIGN_KEY=

# [SHARED] Discord OAuth2 app used for dashboard logins.
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# [SHARED] Nitrado API (per-guild values are read from the DB and override these)
NITRADO_API_TOKEN=
NITRADO_USER_ID=
NITRADO_SERVICE_ID=

# ────────────────────────────────────────────────────────────
#  DASHBOARD-ONLY
# ────────────────────────────────────────────────────────────
# Session signing key. Changes here log everyone out (that is fine and
# independent of the bot).
DASHBOARD_SECRET=generate_a_random_secret_here

# Must be the dashboard's OWN public URL (https://<service>.onrender.com/callback),
# registered in the Discord developer portal.
DISCORD_REDIRECT_URI=http://localhost:5000/callback

# Bot owner (used for the admin badge in the UI).
BOT_OWNER_ID=your_discord_user_id_here

# Where the Discord bot lives — rendered as the "open bot service" link.
# https://<bot-service>.onrender.com
BOT_SERVICE_URL=

# Render injects this automatically; do not set it manually.
# PORT=5000
