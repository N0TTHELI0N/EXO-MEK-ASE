# Environment variables template - copy to .env and fill in real values

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Dashboard
DASHBOARD_SECRET=generate_a_random_secret_here
DISCORD_REDIRECT_URI=http://localhost:5000/callback

# Encryption key for stored secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# ⚠️ Must be IDENTICAL to the Dashboard Service's ENCRYPTION_KEY — this is how
#    the two independent services read each other's encrypted values.
ENCRYPTION_KEY=

# Optional: separate key for signing license keys. Falls back to ENCRYPTION_KEY.
# Must also be identical on the Dashboard Service.
LICENSE_SIGN_KEY=

# ────────────────────────────────────────────────────────────
#  Service topology
# ────────────────────────────────────────────────────────────
# Public URL of the INDEPENDENT dashboard service (own repo/container).
# The bot links to it from /help. Leave empty to hide the link.
DASHBOARD_BASE_URL=https://your-dashboard-service.onrender.com

# Public URL of THIS bot service (the dashboard links back to it).
# Render injects RENDER_EXTERNAL_HOSTNAME, so this is usually automatic.
BOT_SERVICE_URL=

# Bot Owner Discord ID
BOT_OWNER_ID=your_discord_user_id_here

# Nitrado API (optional, can be overridden per-guild via /set-nitrado-token)
NITRADO_API_TOKEN=
NITRADO_USER_ID=
NITRADO_SERVICE_ID=

# Fallback log channel IDs (can be overridden per-guild via /set-log-channel)
PUNISHMENT_LOG_CHANNEL_ID=0
WIPE_LOG_CHANNEL_ID=0
LOG_CHANNEL_ID=0
DINOS_LOG_CHANNEL_ID=0
ITEMS_LOG_CHANNEL_ID=0
PERKS_LOG_CHANNEL_ID=0
SERVER_LOG_CHANNEL_ID=0
AUTOMOD_LOG_CHANNEL_ID=0
