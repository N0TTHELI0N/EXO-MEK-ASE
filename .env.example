# Environment variables template - copy to .env and fill in real values

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gemini AI (optional)
GEMINI_API_KEY=

# Dashboard
DASHBOARD_SECRET=generate_a_random_secret_here
DISCORD_REDIRECT_URI=http://localhost:5000/callback

# Encryption key for stored secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Bot Owner Discord ID
BOT_OWNER_ID=your_discord_user_id_here

# Fallback RCON defaults (can be overridden per-guild via /set-rcon)
RCON_HOST=
RCON_PORT=29015
RCON_PASSWORD=

# Nitrado API (optional, can be overridden per-guild via /set-nitrado-token)
NITRADO_API_TOKEN=
NITRADO_USER_ID=
NITRADO_SERVICE_ID=

# Fallback log channel IDs (can be overridden per-guild via /set-log-channel)
PUNISHMENT_LOG_CHANNEL_ID=0
WIPE_LOG_CHANNEL_ID=0
LOG_CHANNEL_ID=0
DINOS_LOG_CHANNEL_ID=0
ITEMS_LOG_CHANNEL_ID=0
PERKS_LOG_CHANNEL_ID=0
SERVER_LOG_CHANNEL_ID=0
AUTOMOD_LOG_CHANNEL_ID=0
